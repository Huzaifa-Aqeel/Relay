# Relay server-only provider configuration.
# Copy this file to supabase/.env.local for local Edge Functions, or set these
# values with `supabase secrets set` for the hosted project.
# Never place any of these values in the Expo client or an EXPO_PUBLIC_* variable.

# Unstructured Transform API credentials. Use the URL shown for your workspace.
UNSTRUCTURED_API_URL=https://transform.unstructured.io/api/v2
UNSTRUCTURED_API_KEY=

# Astra DB Serverless Data API credentials. The endpoint already identifies the
# database and region; the token must be scoped to that database.
ASTRA_DB_API_ENDPOINT=
ASTRA_DB_APPLICATION_TOKEN=

# Astra target configuration (not credentials). The named collection must be
# created with Vectorize enabled; its configured provider/model owns embeddings.
ASTRA_DB_KEYSPACE=default_keyspace
ASTRA_DB_COLLECTION=relay_handoff_chunks

# Provider-neutral OpenAI-compatible text reasoning. These settings power
# Organize, Ask Relay, and Organization Memory. Use the compatible endpoint
# supplied by your model provider.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=qwen3.8-flash
# DASHSCOPE_BASE_URL, DASHSCOPE_API_KEY, and DASHSCOPE_MODEL are accepted as
# aliases when adopting an existing Model Studio environment.
LLM_ENABLE_THINKING=false
# Optional provider-specific reasoning controls. Leave both blank when thinking
# is disabled. Do not set both at the same time.
LLM_THINKING_BUDGET=
LLM_REASONING_EFFORT=
# Leave blank to use the selected model/provider's full output allowance.
LLM_MAX_OUTPUT_TOKENS=
# End the provider wait before Supabase's 150-second request idle limit so
# Relay can persist a retryable Capture state instead of leaving it processing.
LLM_REQUEST_TIMEOUT_MS=120000

# Groq remains isolated to editable voice transcription. Text reasoning does
# not read these settings.
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# RevenueCat is authoritative for Relay Pro. Use the secret API key only in
# Edge Functions. Configure the webhook to send the exact Authorization value.
REVENUECAT_SECRET_API_KEY=
REVENUECAT_ENTITLEMENT_ID=relay_pro
REVENUECAT_WEBHOOK_AUTHORIZATION=
