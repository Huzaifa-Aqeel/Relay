# Client-safe Supabase values. Never add the service-role key to the Expo environment.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Deployed Relay web origin used by published handoff links, without a trailing slash.
EXPO_PUBLIC_RELAY_WEB_ORIGIN=

# Public EAS project id used when requesting an Expo push token.
EXPO_PUBLIC_EAS_PROJECT_ID=
# RevenueCat requires an Expo development build.
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=relay_pro
